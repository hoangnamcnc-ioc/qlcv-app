# Caddy: HTTPS tự động (Let's Encrypt) + giao diện web + chuyển tiếp dữ liệu/kho file/API về cùng 1 tên miền (không lo CORS).
# Thay __DOMAIN__ bằng tên miền thật (VD: qlcv.ioc-daklak.vn) — setup-server.sh làm việc này tự động.
__DOMAIN__ {
	encode zstd gzip

	# Dữ liệu: PostgREST (cắt tiền tố /rest/v1 vì PostgREST phục vụ ở gốc)
	handle_path /rest/v1/* {
		reverse_proxy 127.0.0.1:3000
	}

	# Kho file đính kèm + email nhắc việc + trợ lý AI: máy chủ API Node
	@api path /storage/v1/* /api/*
	handle @api {
		reverse_proxy 127.0.0.1:3001 {
			flush_interval -1
		}
	}

	# Giao diện web (bản build của dự án)
	handle {
		root * /srv/qlcv/dist
		try_files {path} /index.html
		file_server
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
	}

	request_body {
		max_size 100MB
	}
}

# Cổng NỘI BỘ cho máy chủ API/script gọi dữ liệu theo đúng đường dẫn /rest/v1 (chỉ nghe 127.0.0.1, không ra Internet)
http://127.0.0.1:8000 {
	bind 127.0.0.1
	handle_path /rest/v1/* {
		reverse_proxy 127.0.0.1:3000
	}
	handle /storage/v1/* {
		reverse_proxy 127.0.0.1:3001
	}
}
