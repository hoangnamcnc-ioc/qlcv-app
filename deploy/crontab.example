# crontab của người dùng qlcv (crontab -e). Giờ theo múi giờ máy chủ → đặt CRON_TZ cho chắc.
CRON_TZ=Asia/Ho_Chi_Minh
CRON_SECRET=<dán CRON_SECRET>
# 07:30 Thứ 2–6: email nhắc việc buổi sáng (tương đương Vercel Cron "30 0 * * 1-5" UTC)
30 7 * * 1-5  curl -fsS -H "Authorization: Bearer $CRON_SECRET" http://127.0.0.1:3001/api/daily-digest >> /var/log/qlcv/digest.log 2>&1
# 16:30 hằng ngày: nhắc lịch trực ngày mai (tương đương "30 9 * * *" UTC)
30 16 * * *   curl -fsS -H "Authorization: Bearer $CRON_SECRET" http://127.0.0.1:3001/api/duty-reminder >> /var/log/qlcv/duty.log 2>&1
# 01:30 hằng ngày: sao lưu cơ sở dữ liệu + kho file (xem backup.sh)
30 1 * * *    /opt/qlcv/app/deploy/backup.sh >> /var/log/qlcv/backup.log 2>&1
