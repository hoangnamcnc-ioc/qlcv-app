# /etc/qlcv/api.env — biến môi trường của dịch vụ qlcv-api (chmod 600, chủ sở hữu root)
API_PORT=3001
# Kong nội bộ của Supabase tự chạy (không đi ra Internet)
SUPABASE_URL=http://127.0.0.1:8000
SUPABASE_SERVICE_KEY=<SERVICE_ROLE_KEY trong keys.env>
CRON_SECRET=<CRON_SECRET trong keys.env>
APP_URL=https://__DOMAIN__
# Gửi email qua SMTP (Gmail: dùng "mật khẩu ứng dụng"); lấy đúng giá trị đang dùng trên Vercel
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Trợ lý AI (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
