# Mau cau hinh — sao chep thanh .env roi dien gia tri that. KHONG commit file .env.
# Tren Vercel: dat cac bien nay o Project Settings > Environment Variables (Production).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_KEY=<anon key — Supabase > Settings > API>
# Neu dung co che khoa ghi bang ma PIN (header x-write-pin); de trong neu khong dung
VITE_WRITE_PIN=
# URL proxy AI (tuy chon)
# De trong = ban chinh thuc tu dung /api/ai-intent. Dat "off" de TAT AI hoan toan.
VITE_AI_PROXY_URL=
